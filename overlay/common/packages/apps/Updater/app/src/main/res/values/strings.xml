          {device} - Device name
          {type} - Build type
          {incr} - Incremental version
    -->
    <string name="header_title_text">KapiOS\n%1$s</string>
    <string name="list_build_version">KapiOS <xliff:g id="version" example="14.1">%1$s</xliff:g></string>
    <string name="list_build_version_date">KapiOS <xliff:g id="version" example="14.1">%1$s</xliff:g> - <xliff:g id="date" example="July 11, 2017">%2$s</xliff:g></string>
    <string name="updater_server_url" translatable="false">https://kytech.fr/kapi-ota/{device}.json</string>
